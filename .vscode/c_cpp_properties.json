{
  "version": 4,
  "configurations": [
    {
      "name": "Mac",
      "cStandard": "c11",
      "intelliSenseMode": "macos-clang-arm64",
      "includePath": [
        "${workspaceFolder}/glce",
        "${workspaceFolder}/glce/include",
        "${workspaceFolder}/glce/test/include"
      ],
      "defines": [
        "PLATFORM_MACOS"
      ]
    },
    {
      "name": "Linux",
      "cStandard": "c11",
      "intelliSenseMode": "linux-clang-x64",
      "includePath": [
        "${workspaceFolder}/glce",
        "${workspaceFolder}/glce/include",
        "${workspaceFolder}/glce/test/include"
      ],
      "defines": [
        "PLATFORM_LINUX",
        "_POSIX_C_SOURCE=200809L"
      ]
    }
  ]
}
