# Sample Robot v5 — common motor geometry

# Conceptual configuration example.
 # Material files actuator_mat/link_mat/end_tool_mat must exist in assets/materials/robot_sample/.
# Current runtime uses a dummy C loader, not this file directly.

# Base yaw
[coordinate]
id = 1
parent = 0
translate = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
[/coordinate]

# Shoulder pitch
[coordinate]
id = 2
parent = 1
translate = [0.0, 0.0, 140.0]
rotation = [0.0, 0.0, 0.0]
[/coordinate]

# Elbow pitch
[coordinate]
id = 3
parent = 2
translate = [150.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
[/coordinate]

# Wrist roll
[coordinate]
id = 4
parent = 3
translate = [120.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
[/coordinate]

# Tool mount
[coordinate]
id = 8
parent = 4
translate = [26.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
[/coordinate]

# Left finger
[coordinate]
id = 5
parent = 8
translate = [10.0, 18.0, 0.0]
rotation = [0.0, 0.0, 0.0]
[/coordinate]

# Right finger
[coordinate]
id = 6
parent = 8
translate = [10.0, -18.0, 0.0]
rotation = [0.0, 0.0, 0.0]
[/coordinate]

# TCP
[coordinate]
id = 7
parent = 8
translate = [62.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
[/coordinate]

# Base motor housing (fixed to world / foundation)
[coordinate]
id = 9
parent = 0
translate = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
[/coordinate]

# Fixed foundation (separate from yaw rotation)
[coordinate]
id = 13
parent = 0
translate = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
[/coordinate]

# Motor mount / shoulder Y
[coordinate]
id = 10
parent = 1
translate = [0.0, 0.0, 140.0]
rotation = [-90.0, 0.0, 0.0]
[/coordinate]

# Motor mount / elbow Y
[coordinate]
id = 11
parent = 2
translate = [150.0, 0.0, 0.0]
rotation = [-90.0, 0.0, 0.0]
[/coordinate]

# Motor mount / wrist X
[coordinate]
id = 12
parent = 3
translate = [120.0, 0.0, 0.0]
rotation = [0.0, 90.0, 0.0]
[/coordinate]

[untextured_mesh]
name = base_motor_mount
geometry_subdirectory = stl/robot_sample
material_subdirectory = materials/robot_sample
geometry = base_motor_mount
material = link_mat
coordinate_id = 1
[/untextured_mesh]

